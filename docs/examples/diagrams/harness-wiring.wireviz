# Native wiring fixture: keep this source and its comments during edits.
connectors:
  INPUT:
    pins: ["01", 2, 3]
    pinlabels: [RETURN, POWER, DATA]
  OUTPUT:
    pincount: 3
    pinlabels: [DATA, POWER, RETURN]
  PROBE:
    pincount: 1
    pinlabels: [TEST]
cables:
  LOOM:
    colors: [BK, RD, GNYE]
    shield: true
connections:
  - - INPUT: ["01", 2, 3] # three distinct parallel lanes
    - LOOM: [1-3]
    - OUTPUT: [3-1]
  - [PROBE] # explicitly visible for a new terminal-to-conductor drag
notes: |-
  Disconnect one selected incident link, preserving the other lanes and ends.
  Drag PROBE pin 1 to a LOOM conductor or its shield to create a connection.
