%YAML 1.2
---
name: Configuration
file_extensions: [toml, kdl, ini, conf, cfg, env, service, desktop, properties, editorconfig, gitconfig, gitmodules]
scope: source.configuration
contexts:
  main:
    - match: '/\*'
      scope: punctuation.definition.comment
      push:
        - meta_scope: comment.block
        - match: '\*/'
          pop: true
    - match: '(#(?!true\b|false\b|null\b)|//|^\s*;)'
      scope: punctuation.definition.comment
      push:
        - meta_scope: comment.line
        - match: '\n'
          pop: true
    - match: '"""'
      push:
        - meta_scope: string.quoted.double
        - match: '"""'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double
        - match: '\\.'
          scope: constant.character.escape
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single
        - match: "'"
          pop: true
    - match: '\b(true|false|null|yes|no|on|off)\b'
      scope: constant.language
    - match: '(?<!\w)[+-]?(0x[\da-fA-F_]+|\d[\d_]*(\.\d+)?([eE][+-]?\d+)?)'
      scope: constant.numeric
    - match: '^\s*\[.*?\]'
      scope: entity.name.section
    - match: '[\w.-]+(?=\s*=)'
      scope: variable.other
    - match: '[{}\[\]=(),]'
      scope: punctuation.separator
