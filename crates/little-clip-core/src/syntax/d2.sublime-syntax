%YAML 1.2
---
name: D2
file_extensions: [d2]
scope: source.d2
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.d2
    - match: '"'
      scope: punctuation.definition.string.begin.d2
      push: quoted
    - match: '\|(?:md|markdown|latex|tex|[a-zA-Z][a-zA-Z0-9_-]*)?(?=\s|$)'
      scope: punctuation.definition.string.begin.d2
      push: block-string
    - match: '\b(?:shape|style|icon|label|direction|classes|layers|scenarios|steps|vars|constraint|width|height|near|grid-rows|grid-columns)\b'
      scope: keyword.control.d2
    - match: '<->|->|<-|--'
      scope: keyword.operator.arrow.d2
    - match: '\b(?:true|false|null|right|left|up|down)\b'
      scope: constant.language.d2
    - match: '\b[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.d2
    - match: '[{}\[\]():;]'
      scope: punctuation.section.d2
  quoted:
    - meta_scope: string.quoted.double.d2
    - match: '\\.'
      scope: constant.character.escape.d2
    - match: '"'
      scope: punctuation.definition.string.end.d2
      pop: true
  block-string:
    - meta_scope: string.unquoted.block.d2
    - match: '\|'
      scope: punctuation.definition.string.end.d2
      pop: true
