+// Reuse one paused decoder for bounded keyframe seeks, with no video clock or audio.
+pub struct PreviewSource {
+    pipeline: gst::Pipeline,
+    appsink: gst_app::AppSink,
+    pub width: usize,
+    pub height: usize,
+}
+impl PreviewSource {
+    pub fn new(filename: &str, width: usize, height: usize, stream: i32, gpu: bool) -> Result<Self, String> {
+        gst::init().map_err(|e| e.to_string())?;
+        // Small H.264 keyframes are faster without GPU flush/transfer overhead.
+        if let Some(factory) = gst::ElementFactory::find("avdec_h264") { factory.set_rank(512); }
+        let gpu = gpu && gst::ElementFactory::find("nvh265dec").map_or(false, |factory| factory.get_rank() > 0)
+            && gst::ElementFactory::find("cudaconvertscale").is_some()
+            && gst::ElementFactory::find("cudadownload").is_some();
+        let (pipeline, _, appsink) = build_pipeline(filename, width, height, stream, true, gpu, true);
+        appsink.set_property("max-buffers", &1u32).map_err(|e| e.to_string())?;
+        appsink.set_property("drop", &true).map_err(|e| e.to_string())?;
+        let source = Self { pipeline, appsink, width, height };
+        source.pipeline.set_state(gst::State::Paused).into_result().map_err(|e| format!("Cannot pause decoder: {:?}", e))?;
+        let _ = source.pipeline.get_state(3 * gst::SECOND);
+        Ok(source)
+    }
+    pub fn seek(&self, time_ms: u64) -> Result<frame::Frame, String> {
