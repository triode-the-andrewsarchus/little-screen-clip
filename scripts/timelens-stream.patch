+++ b/src/preview.rs
@@ -0,0 +1,207 @@
+//! Files' fast strip generation and persistent raw-frame protocol.
+use crate::{
+    frame::Frame,
+    source::{ColumnSource, PreviewSource},
+};
+use std::{
+    collections::VecDeque,
+    io::{self, BufRead, Write},
+    time::{Duration, Instant},
+};
+
+pub fn dispatch() -> bool {
+    let args: Vec<String> = std::env::args().collect();
+    let server = args.iter().any(|arg| arg == "--preview-server");
+    let fast = args.iter().any(|arg| arg == "--fast");
+    if !server && !fast {
+        return false;
+    }
+    if let Err(error) = run(&args, server) {
+        eprintln!("{}", error);
+        std::process::exit(1);
+    }
+    true
+}
+fn value<'a>(args: &'a [String], key: &str) -> Result<&'a str, String> {
+    args.windows(2)
+        .find(|pair| pair[0] == key)
+        .map(|pair| pair[1].as_str())
+        .ok_or_else(|| format!("Missing {}", key))
+}
+fn number(args: &[String], key: &str) -> Result<usize, String> {
+    value(args, key)?
+        .parse()
+        .map_err(|_| format!("Invalid {}", key))
+}
+fn run(args: &[String], server: bool) -> Result<(), String> {
+    let path = args.get(1).ok_or("Missing file")?;
+    let width = number(args, "--width")?.clamp(1, 16384);
+    let height = number(args, "--height")?.clamp(1, 1024);
+    let stream = number(args, "--video-stream")? as i32;
+    let gpu = args.iter().any(|arg| arg == "--gpu");
+    if server {
+        let source = PreviewSource::new(path, width, height, stream, gpu)?;
+        let mut cache = VecDeque::<Cached>::new();
+        let input = io::stdin();
+        let mut output = io::stdout().lock();
+        for line in input.lock().lines() {
+            let ms: u64 = line
+                .map_err(|e| e.to_string())?
+                .parse()
+                .map_err(|_| "Invalid timestamp")?;
+            let cached = cache
+                .iter()
+                .position(|frame| frame.from <= ms && ms <= frame.to);
+            let frame = if let Some(index) = cached {
+                cache.remove(index).unwrap()
+            } else {
+                let frame = source.seek(ms)?;
+                let map = frame
+                    .buffer
+                    .map_readable()
+                    .ok_or("Cannot map preview frame")?;
+                let bytes = map.as_slice();
+                if bytes.len() != width * height * 4 {
+                    return Err("Unexpected frame stride".into());
+                }
+                let pts = (frame.pts.unwrap_or(0.0) as f64 * 1000.0).round() as u64;
+                let mut frame = Cached {
+                    from: ms.min(pts),
+                    to: ms.max(pts),
+                    pts,
+                    bytes: bytes.to_vec(),
+                };
+                if let Some(index) = cache.iter().position(|previous| previous.pts == pts) {
+                    let previous = cache.remove(index).unwrap();
+                    frame.from = frame.from.min(previous.from);
+                    frame.to = frame.to.max(previous.to);
+                }
+                frame
+            };
+            let pts = frame.pts;
+            let bytes = &frame.bytes;
+            output
+                .write_all(&pts.to_le_bytes())
+                .map_err(|e| e.to_string())?;
+            output.write_all(bytes).map_err(|e| e.to_string())?;
+            output.flush().map_err(|e| e.to_string())?;
+            cache.push_back(frame);
+            let capacity = (16 * 1024 * 1024 / (width * height * 4)).clamp(1, 8);
+            while cache.len() > capacity {
+                cache.pop_front();
+            }
+        }
+    } else {
+        let duration = number(args, "--duration-ms")? as u64;
+        let source_width = number(args, "--source-width")?.clamp(1, 65536);
+        let source_height = number(args, "--source-height")?.clamp(1, 65536);
+        let scaled_width = ((source_width as f64 / source_height as f64 * height as f64).round()
+            as usize)
+            .clamp(1, 2048);
+        gstreamer::init().map_err(|e| e.to_string())?;
+        let mut timeline = Frame::new(width, height);
+        let mut progress = value(args, "--progressive").ok();
+        let mut known = vec![false; width];
+        let mut updated = None;
+        let codec = value(args, "--codec").unwrap_or("h264");
+        if duration <= 600_000 {
+            let source = ColumnSource::new(
+                path,
+                scaled_width,
+                height,
+                stream,
+                width,
+                duration,
+                gpu,
+                codec,
+            )?;
+            while let Some(frame) = source.next()? {
+                let index = ((frame.pts.unwrap_or(0.0) as f64 * 1000.0 / duration as f64
+                    * width as f64)
+                    .round() as usize)
+                    .min(width - 1);
+                timeline.copy(&frame.scale(1, height), index, 0);
+                known[index] = true;
+                if updated.map_or(true, |time: Instant| time.elapsed() >= Duration::from_millis(250)) {
+                    if let Some(path) = progress {
+                        if publish_progress(path, &timeline, &known).is_err() {
+                            progress = None;
+                        }
+                    }
+                    updated = Some(Instant::now());
+                }
+            }
+        } else {
+            let workers = 4.min(width);
+            let mut jobs = Vec::new();
+            for worker in 0..workers {
+                let path = path.to_owned();
+                let start = worker * width / workers;
+                let end = (worker + 1) * width / workers;
+                jobs.push(std::thread::spawn(
+                    move || -> Result<Vec<(usize, Frame)>, String> {
+                        let source = PreviewSource::new(&path, scaled_width, height, stream, gpu)?;
+                        let mut columns = Vec::with_capacity(end - start);
+                        for index in start..end {
+                            let time = duration.saturating_sub(1) * index as u64
+                                / width.saturating_sub(1).max(1) as u64;
+                            columns.push((index, source.seek(time)?.scale(1, height)));
+                        }
+                        Ok(columns)
+                    },
+                ));
+            }
+            for job in jobs {
+                for (index, column) in job.join().map_err(|_| "Timeline worker failed")?? {
+                    timeline.copy(&column, index, 0);
+                    known[index] = true;
+                }
+                if let Some(path) = progress {
+                    let _ = publish_progress(path, &timeline, &known);
+                }
+            }
+        }
+        timeline.write_to(value(args, "--timeline")?, 100)?;
+    }
+    Ok(())
+}
+
+// A snapped keyframe remains nearest between its PTS and a proven seek target.
+struct Cached {
+    from: u64,
+    to: u64,
+    pts: u64,
+    bytes: Vec<u8>,
+}
+
+// Atomic bounded snapshots: pending positions use the nearest available column.
+// The final timeline remains untouched, including its ordinary-frame sampling.
+fn publish_progress(path: &str, timeline: &Frame, known: &[bool]) -> Result<(), String> {
+    let map = timeline.buffer.map_readable().ok_or("Cannot map timeline")?;
+    let pixels = map.as_slice();
+    let indices: Vec<_> = known.iter().enumerate()
+        .filter_map(|(x, ready)| if *ready { Some(x) } else { None }).collect();
+    if indices.is_empty() {
+        return Ok(());
+    }
+    let mut nearest = Vec::with_capacity(timeline.width);
+    let mut index = 0;
+    for x in 0..timeline.width {
+        while index + 1 < indices.len() &&
+            indices[index + 1].abs_diff(x) < indices[index].abs_diff(x) {
+            index += 1;
+        }
+        nearest.push(indices[index]);
+    }
+    let mut bytes = format!("P6\n{} {}\n255\n", timeline.width, timeline.height).into_bytes();
+    bytes.reserve(timeline.width * timeline.height * 3);
+    for y in 0..timeline.height {
+        for &x in &nearest {
+            let offset = (y * timeline.width + x) * 4;
+            bytes.extend_from_slice(&[pixels[offset + 2], pixels[offset + 1], pixels[offset]]);
+        }
+    }
+    let temporary = format!("{}.tmp", path);
+    std::fs::write(&temporary, bytes).map_err(|e| e.to_string())?;
+    std::fs::rename(&temporary, path).map_err(|e| e.to_string())
+}
