+	if byte_len < 1 || byte_len > usize::from(chunk.len) * BLOCKSIZE - 4 {
+		bail!("Invalid chunk length");
+	}
+	let mut buffer = vec![0; byte_len];
+	reader
+		.read_exact(&mut buffer)
+		.context("Failed to read chunk data")?;
