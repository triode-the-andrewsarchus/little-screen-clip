+/* Present only in the separate test build. Private inherited socket:
+ * A arms a partial write, an eight-byte LE position acknowledges stored bytes,
+ * then R resumes or any other byte fails that write. The wait is bounded.
+ */
+static int test_write_gate_locked(off_t offset, unsigned int stored)
+{
+	static int control = -2, armed;
+	const char *setting;
+	char *end, action;
+	long value;
+	ssize_t received;
+	uint64_t position = (uint64_t)offset + stored;
+	unsigned char bytes[8];
+	struct pollfd waiting;
+	int i;
+
+	if (control == -2) {
+		control = -1;
+		setting = getenv("LITTLE_CLIP_FUSE_TEST_GATE_FD");
+		if (setting) {
+			errno = 0;
+			value = strtol(setting, &end, 10);
+			if (!errno && *setting && !*end && value >= 0 && value <= INT_MAX)
+				control = (int)value;
+		}
+	}
+	if (control < 0)
+		return 0;
+	if (!armed) {
+		received = recv(control, &action, 1, MSG_DONTWAIT);
+		if (received < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+			return 0;
+		if (received != 1 || action != 'A')
+			return -EIO;
+		armed = 1;
+	}
+	if (position < 256 * 1024)
+		return 0;
+	for (i = 0; i < 8; i++)
+		bytes[i] = (unsigned char)(position >> (i * 8));
+	if (send(control, bytes, sizeof(bytes), MSG_NOSIGNAL) != sizeof(bytes))
+		return -EIO;
+	waiting.fd = control;
+	waiting.events = POLLIN;
+	waiting.revents = 0;
+	if (poll(&waiting, 1, 20000) <= 0 || recv(control, &action, 1, 0) != 1)
+		return -EIO;
+	control = -1;
+	return action == 'R' ? 0 : -EIO;
+}
+
+/* Serialize the private control protocol without holding the filesystem lock. */
+static int test_write_gate(off_t offset, unsigned int stored)
+{
+	static pthread_mutex_t control_lock = PTHREAD_MUTEX_INITIALIZER;
+	int fault;
+
+	pthread_mutex_lock(&control_lock);
+	fault = test_write_gate_locked(offset, stored);
+	pthread_mutex_unlock(&control_lock);
+	return fault;
+}
