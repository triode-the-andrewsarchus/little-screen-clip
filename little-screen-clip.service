[Unit]
Description=Little Screen Clip Ambient Hardware Clipboard Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=forking
Environment=LITTLE_SCREEN_CLIP_SYSTEMD=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
WorkingDirectory=@PROJECT_DIR@
ExecStart=/bin/bash ./launch.sh start
ExecStop=/bin/bash ./launch.sh stop
PIDFile=@PROJECT_DIR@/.little-clipd.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target default.target
